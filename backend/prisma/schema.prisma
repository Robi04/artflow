generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AxisType {
  ANATOMY
  PERSPECTIVE
  COMPOSITION
  VALUES
  COLORS
  FIND_MY_STYLE
  LONG_PROJECT
}

enum MissionStatus {
  PENDING
  SUBMITTED
  COMPLETED
}

enum LongProjectStatus {
  IN_PROGRESS
  COMPLETED
}

enum BadgeCondition {
  FIRST_SUBMISSION
  STREAK_4_WEEKS
  STREAK_8_WEEKS
  LONG_PROJECT_COMPLETED
  STYLE_DISCOVERED
  LEVEL_5_AXIS
  LEVEL_10_AXIS
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  globalXp         Int          @default(0)
  globalLevel      Int          @default(1)
  streakCount      Int          @default(0)
  lastSubmissionAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  plan             Plan?
  longProjects     LongProject[]
  badges           UserBadge[]
}

model Plan {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAxes  UserAxis[]
}

model UserAxis {
  id        String    @id @default(uuid())
  planId    String
  axisType  AxisType
  isActive  Boolean   @default(true)
  xp        Int       @default(0)
  level     Int       @default(1)
  createdAt DateTime  @default(now())
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  missions  Mission[]

  @@unique([planId, axisType])
}

model Mission {
  id          String        @id @default(uuid())
  userAxisId  String
  weekNumber  Int
  year        Int
  title       String
  description String?
  status      MissionStatus @default(PENDING)
  xpReward    Int           @default(100)
  dueAt       DateTime
  createdAt   DateTime      @default(now())
  userAxis    UserAxis      @relation(fields: [userAxisId], references: [id], onDelete: Cascade)
  submission  Submission?

  @@unique([userAxisId, weekNumber, year])
}

model Submission {
  id         String   @id @default(uuid())
  missionId  String   @unique
  imageUrl   String
  aiFeedback Json
  xpEarned   Int      @default(0)
  createdAt  DateTime @default(now())
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model LongProject {
  id          String            @id @default(uuid())
  userId      String
  title       String
  description String?
  status      LongProjectStatus @default(IN_PROGRESS)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      LongProjectPhoto[]
}

model LongProjectPhoto {
  id         String      @id @default(uuid())
  projectId  String
  imageUrl   String
  aiFeedback Json?
  createdAt  DateTime    @default(now())
  project    LongProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String         @id @default(uuid())
  name        String         @unique
  description String
  iconUrl     String?
  condition   BadgeCondition @unique
  xpReward    Int            @default(0)
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}
